 "rules": {
  "text_pairs": [
   "ink auf bg0/bg1/caption_bg (>= 12:1)",
   "card_ink auf card/paper/accent-Sticker (>= 7:1)",
   "farbiger Text nur als Sticker-Text mit Rand 8 px, >= 56 px"
  ],
  "contrast_check": {
   "warn_below": 4.5,
   "error_below": 3.0,
   "caption_min": 7.0
  },
  "max_hues_per_frame": 5,
  "gold_reserved_for": [
   "card",
   "caption_hi",
   "number_one",
   "album_slot_filled"
  ],
  "respect_mode": "bg via color.saturate(c, 0.7); accent->ink; accent2->ink_soft; glow aus; Lichtinsel candle alpha 0.18"
 }
